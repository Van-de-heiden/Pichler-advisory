---
import Base from '../layouts/Base.astro';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';
import ContactModal from '../components/ui/ContactModal.astro';

const angebote = [
  {
    id: 'betriebscheck',
    nummer: '01',
    tag: 'Der Einstieg',
    titel: 'Digitaler Betriebscheck',
    lede: 'Wissen, wo es rausläuft — bevor Sie irgendetwas verändern.',
    beschreibung: [
      'Bevor sich Investitionen lohnen, muss klar sein, wo das Problem wirklich liegt. Beim Betriebscheck schaue ich mir an, wie Ihr Betrieb heute läuft: Wie kommt eine Anfrage rein, und was passiert dann? Wie entsteht eine Offerte, wer fasst nach? Wo wird dieselbe Information mehrfach von Hand angefasst?',
      'Das mache ich nicht mit Fragebögen, sondern konkret: Ich schaue mir Ihre echten Abläufe, Werkzeuge und Beispiele an — vor Ort oder remote, ohne den Betrieb aufzuhalten.',
    ],
    liefergegenstand: [
      'Klartext-Bericht: die 3–5 grössten Lecks, in Stunden und Franken gedacht',
      'Priorisierter Massnahmenplan: was zuerst, was es bringt, was es kostet',
      'Sofortmassnahmen, die Sie auch ohne mich umsetzen können',
      'Persönliches Abschlussgespräch — keine Folienschlacht',
    ],
    rahmen: 'Fixer Rahmen. Preis vorab schriftlich. Keine Verpflichtung danach.',
    hinweis: 'Der Bericht gehört Ihnen — auch wenn Sie danach mit jemand anderem umsetzen.',
  },
  {
    id: 'betriebsstruktur',
    nummer: '02',
    tag: 'Das Kernprojekt',
    titel: 'Betriebsstruktur & Automatisierung',
    lede: 'Die Abläufe, die von allein laufen.',
    beschreibung: [
      'Hier entsteht die eigentliche Struktur: Ich verbinde Ihre vorhandenen Werkzeuge — Buchhaltung, E-Mail, Kalender, Website, Telefon — so, dass jeder Schritt vom ersten Kontakt bis zur bezahlten Rechnung einen festen Platz hat. Anfragen werden automatisch erfasst und bestätigt. Offerten entstehen aus Vorlagen statt am Sonntagabend. Nachfassen ist terminiert, nicht dem Zufall überlassen.',
      'Gebaut wird mit bewährter, bezahlbarer Automatisierungstechnik — nicht mit Speziallösungen, die nur ich warten kann. Ich bin an keinen Hersteller gebunden: Was zu Ihrem Betrieb passt, wird eingesetzt; was nicht, kommt nicht rein. Alles wird dokumentiert und Ihrem Team so übergeben, dass es im Alltag ohne Informatikkenntnisse funktioniert. Wenn der Auftritt nach aussen das schwächste Glied ist, gehört auch eine neue Website dazu.',
    ],
    liefergegenstand: [
      'Durchgängiger Prozess von Anfrage bis Rechnung',
      'Automatisierungen für Erfassung, Bestätigung und Nachfassen',
      'Offert- und Dokumentvorlagen, sauber an Ihre Buchhaltung angebunden',
      'Einfaches Betriebs-Cockpit mit Ihren echten Zahlen',
      'Dokumentation und Einführung fürs Team',
    ],
    rahmen: 'Projektbasis, offeriert nach Massnahmenplan — Sie entscheiden pro Massnahme.',
    hinweis: 'Umgesetzt wird nur, was sich gemäss Betriebscheck rechnet.',
  },
  {
    id: 'laufender-betrieb',
    nummer: '03',
    tag: 'Die Begleitung',
    titel: 'Laufender Betrieb',
    lede: 'Damit die Struktur auch in sechs Monaten noch trägt.',
    beschreibung: [
      'Ein Ablauf ist erst dann gut, wenn er auch dann noch funktioniert, wenn sich Ihr Betrieb verändert: neue Mitarbeitende, neues Angebot, mehr Anfragen. Im Monatsmodell überwache ich die Systeme, behebe Störungen, passe Abläufe an und werte die Zahlen mit Ihnen aus.',
      'Sie bekommen keine Hotline und kein Ticketsystem, sondern die Person, die Ihre Struktur gebaut hat — mit direktem Draht.',
    ],
    liefergegenstand: [
      'Überwachung und Unterhalt aller aufgebauten Abläufe',
      'Monatliche Kurzauswertung: Anfragen, Reaktionszeit, Nachfassquote',
      'Kontingent für Anpassungen und neue Automatisierungen',
      'Direkter Kontakt bei Problemen — keine Warteschleife',
    ],
    rahmen: 'Monatsmodell, transparent, jederzeit auf Monatsende kündbar.',
    hinweis: 'Kein Abo-Zwang: Die Struktur gehört Ihnen und läuft auch ohne mich weiter.',
  },
];
---

<Base
  title="Leistungen – Betriebscheck, Betriebsstruktur und laufender Betrieb | Pichler Advisory"
  description="Drei Leistungen, ein System: Digitaler Betriebscheck (Analyse), Aufbau der digitalen Betriebsstruktur mit Automatisierung und laufende Betreuung. Für Schweizer Handwerks- und Gewerbebetriebe."
  breadcrumbs={[{ name: 'Startseite', url: '/' }, { name: 'Leistungen', url: '/leistungen/' }]}
>
  <Nav currentPath="/leistungen" />
  <main>

    <!-- Page hero -->
    <div class="max-w-[1240px] mx-auto px-6 md:px-10 pt-[130px] md:pt-[140px] pb-14">
      <div class="max-w-[720px] reveal">
        <span class="eyebrow block mb-4">Leistungen</span>
        <h1 class="font-display font-medium text-ink m-0 mb-5"
            style="font-size: clamp(2.6rem, 5vw, 4.2rem); line-height: 1.02; letter-spacing: -0.03em;">
          Drei Leistungen.<br />
          <em class="italic text-bordeaux-700" style="font-style:italic;">Ein System.</em>
        </h1>
        <p class="text-[17px] md:text-[19px] leading-[1.65] text-slate m-0">
          Analyse, Aufbau, Betrieb — in dieser Reihenfolge, weil jede Stufe auf der vorherigen
          aufbaut. Sie steigen mit dem Betriebscheck ein und entscheiden nach jedem Schritt neu.
          Kein Paketzwang, keine Standardofferte.
        </p>
      </div>
    </div>

    <!-- Angebote -->
    {angebote.map((a, i) => (
      <div id={a.id} class:list={[i % 2 === 1 ? 'bg-ivory border-y border-stone/20' : 'bg-white']}>
        <div class="max-w-[1240px] mx-auto px-6 md:px-10 py-16 md:py-20">
          <div class="grid lg:grid-cols-[1.2fr_0.8fr] gap-10 lg:gap-20 items-start reveal">

            <!-- Text -->
            <div>
              <div class="flex items-center gap-4 mb-6">
                <span class="font-display text-[40px] font-medium leading-none text-bordeaux-300">{a.nummer}</span>
                <span class="text-[10.5px] tracking-[0.14em] uppercase font-semibold bg-bordeaux-700 text-ivory px-3 py-1.5 rounded-sm">{a.tag}</span>
              </div>
              <h2 class="font-display font-medium text-ink mb-2"
                  style="font-size: clamp(1.8rem, 2.8vw, 2.5rem); line-height: 1.08; letter-spacing: -0.02em;">
                {a.titel}
              </h2>
              <p class="text-[16px] md:text-[17px] font-medium text-bordeaux-700 mb-5 leading-snug">{a.lede}</p>
              {a.beschreibung.map((abs) => (
                <p class="text-[15.5px] leading-[1.75] text-slate mb-4">{abs}</p>
              ))}
            </div>

            <!-- Liefergegenstand -->
            <div class="bg-white border border-stone/50 rounded-xl p-7 shadow-sm lg:sticky lg:top-28">
              <p class="text-[11px] tracking-[0.14em] uppercase text-taupe font-semibold mb-4">Das erhalten Sie</p>
              <ul class="flex flex-col gap-3 m-0 mb-6 p-0 list-none">
                {a.liefergegenstand.map((item) => (
                  <li class="flex items-start gap-3 text-[14px] leading-[1.55] text-slate">
                    <span class="flex-shrink-0 w-[15px] h-[15px] mt-[3px] rounded-sm bg-bordeaux-50 text-bordeaux-700 flex items-center justify-center">
                      <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="20 6 9 17 4 12"/>
                      </svg>
                    </span>
                    {item}
                  </li>
                ))}
              </ul>
              <div class="border-t border-mist pt-4 mb-5">
                <p class="text-[13px] leading-[1.55] text-ink font-medium m-0 mb-1.5">{a.rahmen}</p>
                <p class="text-[12.5px] leading-[1.55] text-taupe m-0">{a.hinweis}</p>
              </div>
              <button data-open-contact class="btn-primary btn-block">
                Betriebscheck anfragen
              </button>
            </div>

          </div>
        </div>
      </div>
    ))}

    <!-- CTA -->
    <div class="bg-white border-t border-mist">
      <div class="max-w-[1240px] mx-auto px-6 md:px-10 py-20 text-center reveal">
        <h2 class="font-display font-medium text-ink m-0 mb-4"
            style="font-size: clamp(1.9rem, 3vw, 2.6rem); line-height: 1.08; letter-spacing: -0.03em;">
          Nicht sicher, was Ihr Betrieb braucht?
        </h2>
        <p class="text-[16px] md:text-[17px] leading-[1.65] text-slate mb-8 max-w-[46ch] mx-auto">
          Genau dafür ist der Betriebscheck da: Er zeigt, wo der Hebel am grössten ist —
          bevor Sie einen Franken in Umsetzung investieren.
        </p>
        <button data-open-contact class="btn-primary btn-lg">
          Betriebscheck anfragen
        </button>
      </div>
    </div>

  </main>
  <Footer />
  <ContactModal />
</Base>
