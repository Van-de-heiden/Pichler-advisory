---
import Base from '../layouts/Base.astro';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';
import ContactModal from '../components/ui/ContactModal.astro';

const phasen = [
  {
    num: '01',
    titel: 'Analysieren',
    untertitel: 'Verstehen, wie es heute wirklich läuft',
    text: 'Am Anfang steht kein Konzept, sondern Zuhören und Hinschauen. Ich will wissen, wie eine Anfrage bei Ihnen wirklich reinkommt und was dann passiert — nicht, wie es auf dem Papier aussehen sollte. Dafür schaue ich mir echte Beispiele an: die letzte Offerte, die liegen blieb; den Ordner, in dem Rapporte landen; das Postfach am Montagmorgen. Vor Ort oder remote, in einem Umfang, der Ihren Betrieb nicht aufhält.',
    dauer: 'Halber bis ganzer Tag im Betrieb, plus Auswertung',
    ergebnis: 'Klartext-Bericht: die grössten Lecks, in Stunden und Franken',
  },
  {
    num: '02',
    titel: 'Priorisieren',
    untertitel: 'Die richtigen Hebel zuerst',
    text: 'Nicht alles auf einmal — das ist keine Floskel, sondern der Kern des Vorgehens. Aus der Analyse entsteht ein Massnahmenplan, sortiert nach Wirkung und Aufwand. Quick Wins, die in Tagen umgesetzt sind, stehen zuoberst. Grössere Umbauten kommen erst, wenn die schnellen Verbesserungen ihren Wert gezeigt haben. Sie entscheiden pro Massnahme — mit Preis und erwartetem Nutzen auf dem Tisch.',
    dauer: 'Ein gemeinsames Gespräch',
    ergebnis: 'Priorisierter Massnahmenplan mit klaren Kosten',
  },
  {
    num: '03',
    titel: 'Aufbauen',
    untertitel: 'Umsetzen, im laufenden Betrieb',
    text: 'Ich baue selbst — keine Weitergabe an ein Team, das Ihren Betrieb nicht kennt. Abläufe werden verbunden, Automatisierungen eingerichtet, Vorlagen erstellt, das Cockpit aufgesetzt. Jede Änderung wird so eingeführt, dass der Alltag weiterläuft: erst parallel getestet, dann umgestellt, dann dem Team gezeigt. Alles wird dokumentiert, verständlich und ohne Fachchinesisch.',
    dauer: 'Je nach Umfang — typisch zwei bis sechs Wochen',
    ergebnis: 'Funktionierende Struktur, dokumentiert und übergeben',
  },
  {
    num: '04',
    titel: 'Betreiben & messen',
    untertitel: 'Ehrlich hinschauen, was es gebracht hat',
    text: 'Vier Wochen nach der Umsetzung vergleichen wir die vorher definierten Messpunkte: Wie schnell wird auf Anfragen reagiert? Wie viele Offerten werden nachgefasst? Wie viele Bürostunden sind weggefallen? Die Zahlen entscheiden, nicht mein Eindruck. Danach wählen Sie: Die Struktur läuft selbstständig weiter — oder ich betreue sie im Monatsmodell und entwickle sie mit Ihrem Betrieb weiter.',
    dauer: 'Laufend, mit fixem Messpunkt nach vier Wochen',
    ergebnis: 'Messbarer Vorher-nachher-Vergleich',
  },
];
---

<Base
  title="Vorgehen – In vier Phasen zur digitalen Betriebsstruktur | Pichler Advisory"
  description="Analysieren, priorisieren, aufbauen, betreiben: So entsteht bei Pichler Advisory eine digitale Betriebsstruktur für Schweizer KMU – mit klarem Ergebnis pro Phase und messbarem Vorher-nachher-Vergleich."
  breadcrumbs={[{ name: 'Startseite', url: '/' }, { name: 'Vorgehen', url: '/vorgehen/' }]}
>
  <Nav currentPath="/vorgehen" />
  <main>

    <!-- Page hero -->
    <div class="max-w-[1240px] mx-auto px-6 md:px-10 pt-[130px] md:pt-[140px] pb-16">
      <div class="max-w-[700px] reveal">
        <span class="eyebrow block mb-4">Vorgehen</span>
        <h1 class="font-display font-medium text-ink m-0 mb-5"
            style="font-size: clamp(2.6rem, 5vw, 4.2rem); line-height: 1.02; letter-spacing: -0.03em;">
          Vier Phasen.<br />
          <em class="italic text-bordeaux-700" style="font-style:italic;">Jede mit einem Ergebnis.</em>
        </h1>
        <p class="text-[17px] md:text-[19px] leading-[1.65] text-slate m-0">
          Sie wissen zu jedem Zeitpunkt, was gerade passiert, was es kostet und was Sie dafür in
          der Hand haben. Und nach jeder Phase können Sie aussteigen — mit einem Resultat, das
          auch ohne mich brauchbar ist.
        </p>
      </div>
    </div>

    <!-- Phasen -->
    {phasen.map((p, i) => (
      <div class:list={[i % 2 === 1 ? 'bg-ivory border-y border-stone/20' : 'bg-white']}>
        <div class="max-w-[1240px] mx-auto px-6 md:px-10 py-16 md:py-[76px]">
          <div class="grid lg:grid-cols-[170px_1fr_260px] gap-8 lg:gap-14 items-start reveal">

            <!-- Nummer -->
            <div class="hidden lg:block">
              <span class="font-display leading-none text-bordeaux-700/15 select-none block"
                    style="font-size: clamp(5rem, 8vw, 7rem); font-weight: 500;">
                {p.num}
              </span>
            </div>

            <!-- Inhalt -->
            <div>
              <span class="text-[11px] tracking-[0.14em] uppercase text-taupe font-semibold block mb-3">
                <span class="lg:hidden font-display text-[16px] text-bordeaux-300 normal-case tracking-normal mr-2">{p.num}</span>
                {p.untertitel}
              </span>
              <h2 class="font-display font-medium text-ink mb-5"
                  style="font-size: clamp(1.9rem, 3vw, 2.6rem); line-height: 1.07; letter-spacing: -0.02em;">
                {p.titel}
              </h2>
              <p class="text-[16px] leading-[1.8] text-slate m-0">{p.text}</p>
            </div>

            <!-- Meta -->
            <div class="flex flex-col gap-3 lg:pt-2">
              <div class:list={['rounded-lg px-4 py-3.5 border', i % 2 === 1 ? 'bg-white border-stone/40' : 'bg-ivory border-stone/40']}>
                <span class="text-[10px] tracking-[0.1em] uppercase text-taupe block mb-1">Dauer</span>
                <span class="text-[13.5px] font-medium text-ink leading-snug">{p.dauer}</span>
              </div>
              <div class="rounded-lg px-4 py-3.5 bg-bordeaux-50 border border-bordeaux-100">
                <span class="text-[10px] tracking-[0.1em] uppercase text-bordeaux-300 block mb-1">Ergebnis</span>
                <span class="text-[13.5px] font-medium text-bordeaux-800 leading-snug">{p.ergebnis}</span>
              </div>
            </div>

          </div>
        </div>
      </div>
    ))}

    <!-- CTA -->
    <div class="max-w-[1240px] mx-auto px-6 md:px-10 py-20 md:py-24 text-center reveal">
      <span class="rule-divider mb-7"></span>
      <h2 class="font-display font-medium text-ink m-0 mb-4"
          style="font-size: clamp(1.9rem, 3vw, 2.7rem); line-height: 1.08; letter-spacing: -0.03em;">
        Phase eins beginnt mit einem Gespräch.
      </h2>
      <p class="text-[16px] md:text-[17px] leading-[1.65] text-slate mb-8 max-w-[46ch] mx-auto">
        Der digitale Betriebscheck ist der Einstieg — fixer Rahmen, Preis vorab,
        Resultat auch ohne Folgeauftrag brauchbar.
      </p>
      <button data-open-contact class="btn-primary btn-lg">
        Betriebscheck anfragen
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </button>
    </div>

  </main>
  <Footer />
  <ContactModal />
</Base>
