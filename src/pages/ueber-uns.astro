---
import Base from '../layouts/Base.astro';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';
import ContactModal from '../components/ui/ContactModal.astro';

const haltung = [
  {
    titel: 'Umsetzung zählt, nicht Papier',
    text: 'Ein Konzept, das in der Schublade landet, hat null Wirkung. Ich baue selbst, führe ein und bleibe dran, bis es im Alltag läuft — erst dann ist die Arbeit fertig.',
  },
  {
    titel: 'Ehrlichkeit vor Gefälligkeit',
    text: 'Wenn eine Massnahme sich für Ihren Betrieb nicht rechnet, sage ich das — auch wenn ich damit einen Auftrag nicht bekomme. Anders lässt sich Vertrauen nicht aufbauen, schon gar nicht als junger Anbieter.',
  },
  {
    titel: 'Ihre Werkzeuge, nicht meine Lieblinge',
    text: 'Ich verkaufe keine Software und bekomme keine Provisionen. Empfohlen wird, was zu Ihrem Betrieb passt — im Zweifel das, was Sie schon haben.',
  },
  {
    titel: 'Verständlich oder gar nicht',
    text: 'Jede Automatisierung, die ich baue, muss ich Ihnen in zwei Minuten erklären können. Wenn nicht, ist sie zu kompliziert für den Betriebsalltag.',
  },
];
---

<Base
  title="Über mich – Maurus Pichler, Pichler Advisory | Digitale Betriebsstruktur für KMU"
  description="Maurus Pichler, Gründer von Pichler Advisory aus Ernetschwil SG: Entwickler digitales Business EFZ, spezialisiert auf Prozessanalyse und Automatisierung für Schweizer Handwerks- und Gewerbebetriebe."
  breadcrumbs={[{ name: 'Startseite', url: '/' }, { name: 'Über mich', url: '/ueber-uns/' }]}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'Über Pichler Advisory',
    description: 'Maurus Pichler, Gründer von Pichler Advisory – Prozessanalyse und digitale Betriebsstruktur für Schweizer KMU.',
    url: 'https://pichler-advisory.ch/ueber-uns/',
    mainEntity: {
      '@type': 'Person',
      name: 'Maurus Pichler',
      jobTitle: 'Gründer & Inhaber',
      worksFor: { '@type': 'Organization', name: 'Pichler Advisory', url: 'https://pichler-advisory.ch' },
      address: { '@type': 'PostalAddress', addressLocality: 'Ernetschwil', postalCode: '8725', addressCountry: 'CH', addressRegion: 'Kanton St. Gallen' },
      email: 'info@pichler-advisory.ch',
      telephone: '+41775383064',
    },
  }}
>
  <Nav currentPath="/ueber-uns" />
  <main>

    <!-- Page hero -->
    <div class="max-w-[1240px] mx-auto px-6 md:px-10 pt-[130px] md:pt-[140px] pb-16">
      <div class="max-w-[720px] reveal">
        <span class="eyebrow block mb-4">Über mich</span>
        <h1 class="font-display font-medium text-ink m-0 mb-5"
            style="font-size: clamp(2.6rem, 5vw, 4.2rem); line-height: 1.02; letter-spacing: -0.03em;">
          Jung ist kein Nachteil.<br />
          <em class="italic text-bordeaux-700" style="font-style:italic;">Wenn man liefert.</em>
        </h1>
        <p class="text-[17px] md:text-[19px] leading-[1.65] text-slate m-0">
          Pichler Advisory ist ein Ein-Personen-Betrieb — bewusst. Sie arbeiten mit der Person,
          die analysiert, baut und verantwortet. Hier steht, wer das ist und wie ich denke.
        </p>
      </div>
    </div>

    <!-- Founder story -->
    <div class="max-w-[1240px] mx-auto px-6 md:px-10 pb-20">
      <div class="grid lg:grid-cols-[0.85fr_1.15fr] gap-12 lg:gap-16 items-start">

        <!-- Photo -->
        <div class="reveal">
          <div class="rounded-xl overflow-hidden shadow-md relative bg-mist border border-stone/50 max-w-[440px]" style="aspect-ratio: 4/5;">
            <img
              src="/assets/maurus_portrait.jpg"
              alt="Maurus Pichler, Gründer von Pichler Advisory"
              width="1200" height="1600" loading="eager"
              class="absolute inset-0 w-full h-full object-cover" style="object-position: 50% 20%;"
            />
            <div class="absolute bottom-0 left-0 right-0 p-5"
                 style="background: linear-gradient(to top, rgba(21,20,23,0.85) 0%, transparent 100%);">
              <p class="text-[14px] font-semibold text-ivory m-0">Maurus Pichler</p>
              <p class="text-[12px] text-stone/80 m-0">Gründer & Inhaber</p>
            </div>
          </div>
        </div>

        <!-- Story -->
        <div class="reveal" style="transition-delay: 100ms;">
          <h2 class="font-display font-medium text-ink mb-5"
              style="font-size: clamp(1.7rem, 2.4vw, 2.2rem); line-height: 1.1; letter-spacing: -0.02em;">
            Wer hinter Pichler Advisory steht
          </h2>
          <div class="flex flex-col gap-4 text-[16px] leading-[1.78] text-slate">
            <p class="m-0">
              Ich bin Maurus Pichler, aufgewachsen in Ernetschwil im Kanton St. Gallen, Jahrgang 2006.
              Unternehmerisch unterwegs bin ich seit ich siebzehn bin — angefangen mit einer eigenen
              Kleidermarke, danach diverse kleinere Projekte, vor allem digitale.
            </p>
            <p class="m-0">
              Beruflich stecke ich im letzten Jahr meiner Ausbildung zum <strong class="text-ink font-semibold">Entwickler
              digitales Business EFZ</strong> — ein Beruf, den es genau deshalb gibt, weil Betriebe Menschen
              brauchen, die Prozesse analysieren, Engpässe finden und digitale Abläufe bauen können.
              Das ist keine Nebenqualifikation, die ich mir angelesen habe. Es ist das, was ich jeden
              Tag mache: Abläufe zerlegen, Flaschenhälse identifizieren, automatisieren, messen.
            </p>
            <p class="m-0">
              Ich bin nicht der Fachmann in Ihrem Handwerk — das sind Sie, und das bleibt so.
              Was ich mitbringe, ist der Blick von aussen ohne Betriebsblindheit, die aktuelle
              Technik ohne Lernkurve und die Bereitschaft, selbst Hand anzulegen statt Empfehlungen
              abzugeben. Von draussen sieht man oft, was drinnen längst normal geworden ist.
            </p>
            <p class="m-0">
              Und ja: Ich bin am Anfang. Das heisst auch — jedes Projekt trägt meinen Namen, jede
              Referenz muss ich mir verdienen, und ich kann mir keinen einzigen unzufriedenen
              Kunden leisten. Sie dürfen das ruhig als Sicherheit verstehen.
            </p>
          </div>
        </div>

      </div>
    </div>

    <!-- Haltung -->
    <div class="bg-ivory border-y border-stone/20">
      <div class="max-w-[1240px] mx-auto px-6 md:px-10 py-20">
        <div class="max-w-[560px] mb-12 reveal">
          <span class="eyebrow block mb-4">Arbeitsweise</span>
          <h2 class="font-display font-medium text-ink mt-4 m-0"
              style="font-size: clamp(1.9rem, 3vw, 2.6rem); line-height: 1.08; letter-spacing: -0.03em;">
            Vier Grundsätze,<br />an denen Sie mich messen können.
          </h2>
        </div>
        <div class="grid md:grid-cols-2 gap-5 stagger">
          {haltung.map((v, i) => (
            <div class="bg-white border border-stone/40 rounded-xl p-7 shadow-sm" style={`--i: ${i}`}>
              <span class="font-display text-[18px] font-medium text-bordeaux-300 block mb-3">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="font-body text-[16.5px] font-semibold text-ink mb-2.5">{v.titel}</h3>
              <p class="text-[14.5px] leading-[1.68] text-slate m-0">{v.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Werkzeuge / Kompetenz -->
    <div class="max-w-[1240px] mx-auto px-6 md:px-10 py-20">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">
        <div class="reveal">
          <span class="eyebrow block mb-4">Womit ich arbeite</span>
          <h2 class="font-display font-medium text-ink mt-4 mb-5"
              style="font-size: clamp(1.9rem, 3vw, 2.5rem); line-height: 1.08; letter-spacing: -0.03em;">
            Bewährte Technik,<br />unspektakulär eingesetzt.
          </h2>
          <p class="text-[16px] leading-[1.75] text-slate m-0">
            Ich bin an keinen Hersteller gebunden und verdiene nichts am Verkauf von Software.
            Die Struktur entsteht aus dem, was sich in Schweizer KMU bewährt hat und zu Ihrem
            Betrieb passt: Ihre Buchhaltung, saubere Formulare auf der Website, Kalender und
            E-Mail, die zusammenspielen — verbunden durch eine zuverlässige Automatisierungsebene.
            KI kommt dort zum Einsatz, wo sie konkret Arbeit abnimmt — etwa beim Vorformulieren
            von Antworten — und nirgendwo sonst.
          </p>
        </div>
        <div class="grid sm:grid-cols-2 gap-4 stagger">
          {[
            { t: 'Anbindung & Schnittstellen', d: 'Offerten, Rechnungen, Kontakte — Ihre bestehenden Programme sauber angebunden statt manuell nachgeführt.' },
            { t: 'Automatisierung', d: 'Die Ebene dazwischen: verbindet Formulare, E-Mail, Kalender und Buchhaltung — im Hintergrund, zuverlässig.' },
            { t: 'Website & Formulare', d: 'Anfragen strukturiert erfassen statt als lose E-Mails und Zettel.' },
            { t: 'Cockpit & Auswertung', d: 'Ihre Zahlen auf einen Blick — Umsatz, Offerten, Nachfassungen.' },
          ].map((w, i) => (
            <div class="border border-stone/40 rounded-xl p-5 bg-white" style={`--i: ${i}`}>
              <p class="text-[14.5px] font-semibold text-ink m-0 mb-1.5">{w.t}</p>
              <p class="text-[13px] leading-[1.6] text-slate m-0">{w.d}</p>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="bg-ivory border-t border-stone/20">
      <div class="max-w-[1240px] mx-auto px-6 md:px-10 py-20 text-center reveal">
        <h2 class="font-display font-medium text-ink m-0 mb-4"
            style="font-size: clamp(1.9rem, 3vw, 2.6rem); line-height: 1.08; letter-spacing: -0.03em;">
          Lernen wir uns kennen.
        </h2>
        <p class="text-[16px] md:text-[17px] leading-[1.65] text-slate mb-8 max-w-[44ch] mx-auto">
          Ein erstes Gespräch kostet nichts und verpflichtet zu nichts —
          es zeigt nur, ob es passt.
        </p>
        <button data-open-contact class="btn-primary btn-lg">
          Betriebscheck anfragen
        </button>
      </div>
    </div>

  </main>
  <Footer />
  <ContactModal />
</Base>
