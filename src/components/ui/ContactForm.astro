---
/**
 * Gemeinsames Lead-Formular (Modal + Kontaktseite).
 * Zweistufig: Pflichtfelder zuerst, Qualifizierung optional einklappbar.
 * Sendet strukturiertes JSON an /api/lead (Cloudflare Pages Function),
 * das später sauber an die Automatisierungsebene weitergereicht werden kann.
 * Feldschema: siehe docs/LEAD-SCHEMA.md
 */
interface Props {
  leadSource: string;      // z. B. 'nav_modal', 'kontaktseite', 'cta_banner'
  compact?: boolean;       // Modal-Variante: etwas dichter
}
const { leadSource, compact = false } = Astro.props;
const uid = leadSource.replace(/[^a-z0-9]/gi, '-');

const branchen = [
  'Gartenbau / Landschaftsbau',
  'Sanitär / Heizung',
  'Elektro',
  'Schreinerei / Holzbau',
  'Malerei / Gipserei',
  'Bau / Baunebengewerbe',
  'Anderes Handwerk',
  'Andere Branche',
];
const groessen = ['1–2 Mitarbeitende', '3–5 Mitarbeitende', '6–15 Mitarbeitende', 'über 15 Mitarbeitende'];
const probleme = [
  'Anfragen gehen unter oder bleiben liegen',
  'Offerten dauern zu lange',
  'Kein Nachfassen nach Offerten',
  'Zu viel Büroarbeit von Hand',
  'Keine Übersicht über Zahlen und Aufträge',
  'Veralteter Auftritt / zu wenig Anfragen',
  'Etwas anderes',
];
const dringlichkeiten = [
  'So bald wie möglich',
  'In den nächsten 3 Monaten',
  'Ich informiere mich erst',
];
---

<form class:list={['lead-form flex flex-col', compact ? 'gap-3.5' : 'gap-4']} data-lead-form data-lead-source={leadSource} novalidate>

  <!-- Honeypot (Spam) -->
  <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

  <div class="grid sm:grid-cols-2 gap-4">
    <label class="flex flex-col gap-1.5">
      <span class="field-label">Name *</span>
      <input type="text" name="name" placeholder="Ihr Name" required autocomplete="name" class="field-input" />
    </label>
    <label class="flex flex-col gap-1.5">
      <span class="field-label">Firma / Betrieb *</span>
      <input type="text" name="firma" placeholder="Name des Betriebs" required autocomplete="organization" class="field-input" />
    </label>
  </div>

  <div class="grid sm:grid-cols-2 gap-4">
    <label class="flex flex-col gap-1.5">
      <span class="field-label">E-Mail *</span>
      <input type="email" name="email" placeholder="ihre@firma.ch" required autocomplete="email" class="field-input" />
    </label>
    <label class="flex flex-col gap-1.5">
      <span class="field-label">Telefon</span>
      <input type="tel" name="telefon" placeholder="+41 xx xxx xx xx" autocomplete="tel" class="field-input" />
    </label>
  </div>

  <label class="flex flex-col gap-1.5">
    <span class="field-label">Branche *</span>
    <select name="branche" required class="field-input">
      <option value="" disabled selected>Bitte wählen</option>
      {branchen.map((b) => <option value={b}>{b}</option>)}
    </select>
  </label>

  <!-- Optionale Qualifizierung -->
  <details class="qualify group border border-mist rounded-md bg-ivory/60">
    <summary class="flex items-center justify-between gap-3 cursor-pointer select-none px-4 py-3 text-[13.5px] font-medium text-slate hover:text-ink transition-colors duration-[180ms]">
      <span>Ein paar Angaben mehr — damit ich das Gespräch vorbereiten kann <span class="text-taupe font-normal">(optional)</span></span>
      <svg class="chevron flex-shrink-0 w-4 h-4 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="6 9 12 15 18 9"/>
      </svg>
    </summary>
    <div class="px-4 pb-4 pt-1 flex flex-col gap-4">
      <div class="grid sm:grid-cols-2 gap-4">
        <label class="flex flex-col gap-1.5">
          <span class="field-label">Betriebsgrösse</span>
          <select name="betriebsgroesse" class="field-input">
            <option value="" selected>Bitte wählen</option>
            {groessen.map((g) => <option value={g}>{g}</option>)}
          </select>
        </label>
        <label class="flex flex-col gap-1.5">
          <span class="field-label">Zeithorizont</span>
          <select name="dringlichkeit" class="field-input">
            <option value="" selected>Bitte wählen</option>
            {dringlichkeiten.map((d) => <option value={d}>{d}</option>)}
          </select>
        </label>
      </div>
      <label class="flex flex-col gap-1.5">
        <span class="field-label">Grösstes Problem im Alltag</span>
        <select name="hauptproblem" class="field-input">
          <option value="" selected>Bitte wählen</option>
          {probleme.map((p) => <option value={p}>{p}</option>)}
        </select>
      </label>
      <label class="flex flex-col gap-1.5">
        <span class="field-label">Womit arbeiten Sie heute?</span>
        <input type="text" name="tools" placeholder="z. B. Bexio, Excel, WhatsApp, Papier" class="field-input" />
      </label>
    </div>
  </details>

  <label class="flex flex-col gap-1.5">
    <span class="field-label">Ihre Nachricht</span>
    <textarea name="nachricht" rows={compact ? 3 : 4}
      placeholder="Kurz in Ihren Worten: Was läuft heute nicht rund?"
      class="field-input resize-none"></textarea>
  </label>

  <label class="flex items-start gap-3 cursor-pointer">
    <input type="checkbox" name="einwilligung" required
      class="mt-0.5 w-4 h-4 flex-shrink-0 accent-[#5A0F1B]" />
    <span class="text-[13px] leading-[1.55] text-slate">
      Ich bin einverstanden, dass meine Angaben zur Bearbeitung der Anfrage verarbeitet werden.
      Details in der <a href="/datenschutz" class="text-bordeaux-700 underline underline-offset-2">Datenschutzerklärung</a>. *
    </span>
  </label>

  <button type="submit" class="btn-primary btn-block mt-1">
    <span data-submit-label>Anfrage senden</span>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M5 12h14M12 5l7 7-7 7"/>
    </svg>
  </button>

  <p class="text-[12.5px] text-taupe text-center m-0">
    Sie erhalten innert 24 Stunden eine persönliche Antwort. Keine Werbe-Mails, keine Weitergabe.
  </p>

  <!-- Fehlermeldung -->
  <p class="form-error hidden text-[13.5px] text-bordeaux-700 bg-bordeaux-50 border border-bordeaux-100 rounded-md px-4 py-3 m-0" role="alert"></p>
</form>

<!-- Erfolgszustand -->
<div class="lead-success hidden text-center py-6" data-success-for={uid}>
  <span class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-positive-soft text-positive mb-4">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="20 6 9 17 4 12"/>
    </svg>
  </span>
  <h3 class="font-display font-medium text-[26px] tracking-[-0.02em] text-ink mb-2">Anfrage erhalten.</h3>
  <p class="text-[15px] text-slate leading-relaxed m-0">
    Vielen Dank. Ich melde mich innert 24 Stunden persönlich bei Ihnen —<br class="hidden sm:block" />
    in der Regel deutlich schneller.
  </p>
</div>

<style>
  details.qualify summary::-webkit-details-marker { display: none; }
  details.qualify[open] .chevron { transform: rotate(180deg); }
</style>

<script>
  /**
   * Ein Handler für alle Lead-Formulare auf der Seite.
   * Baut das stabile Payload gemäss docs/LEAD-SCHEMA.md und sendet an /api/lead.
   */
  document.querySelectorAll<HTMLFormElement>('[data-lead-form]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const errorBox = form.querySelector<HTMLElement>('.form-error');
      errorBox?.classList.add('hidden');

      // Native Validierung anzeigen
      if (!form.reportValidity()) return;

      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const label = form.querySelector<HTMLElement>('[data-submit-label]');
      if (btn) btn.disabled = true;
      if (label) label.textContent = 'Wird gesendet…';

      const fd = new FormData(form);
      const payload = {
        lead: {
          name: String(fd.get('name') ?? '').trim(),
          firma: String(fd.get('firma') ?? '').trim(),
          email: String(fd.get('email') ?? '').trim(),
          telefon: String(fd.get('telefon') ?? '').trim(),
          branche: String(fd.get('branche') ?? ''),
          betriebsgroesse: String(fd.get('betriebsgroesse') ?? ''),
          hauptproblem: String(fd.get('hauptproblem') ?? ''),
          tools: String(fd.get('tools') ?? '').trim(),
          dringlichkeit: String(fd.get('dringlichkeit') ?? ''),
          nachricht: String(fd.get('nachricht') ?? '').trim(),
          einwilligung: fd.get('einwilligung') === 'on',
        },
        meta: {
          lead_source: form.dataset.leadSource ?? 'unbekannt',
          page: location.pathname,
          submitted_at: new Date().toISOString(),
        },
        website: String(fd.get('website') ?? ''), // Honeypot
      };

      try {
        const res = await fetch('/api/lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const json = await res.json().catch(() => ({ success: false }));
        if (!res.ok || !json.success) throw new Error(json.message || 'Senden fehlgeschlagen');

        form.classList.add('hidden');
        const success = form.parentElement?.querySelector('.lead-success');
        success?.classList.remove('hidden');
      } catch {
        if (btn) btn.disabled = false;
        if (label) label.textContent = 'Anfrage senden';
        if (errorBox) {
          errorBox.textContent =
            'Das Senden hat nicht geklappt. Bitte versuchen Sie es erneut — oder schreiben Sie direkt an info@pichler-advisory.ch.';
          errorBox.classList.remove('hidden');
        }
      }
    });
  });
</script>
