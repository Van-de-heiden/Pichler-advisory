---
import ContactForm from './ContactForm.astro';
---

<dialog
  id="contact-modal"
  class="bg-white rounded-xl p-8 sm:p-10 shadow-lg w-full max-w-[560px] mx-auto border-0
         backdrop:bg-ink/55 backdrop:backdrop-blur-sm"
>
  <!-- Close -->
  <button
    data-close-modal
    class="absolute top-5 right-5 text-taupe hover:text-ink transition-colors duration-[180ms] ease-standard bg-transparent border-0 cursor-pointer p-1"
    aria-label="Schliessen"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
    </svg>
  </button>

  <span class="eyebrow">Digitaler Betriebscheck</span>
  <h2 class="font-display font-medium text-[30px] tracking-[-0.02em] text-ink mt-3 mb-2">
    Betriebscheck anfragen
  </h2>
  <p class="text-[15px] leading-relaxed text-slate mb-6">
    Kurz ausfüllen — ich melde mich persönlich. Vertraulich und ohne Verpflichtung.
  </p>

  <ContactForm leadSource="modal" compact={true} />
</dialog>

<script>
  const modal = document.getElementById('contact-modal') as HTMLDialogElement | null;
  modal?.querySelectorAll('[data-close-modal]').forEach((btn) =>
    btn.addEventListener('click', () => modal.close())
  );
</script>

<style>
  dialog { max-height: calc(100dvh - 32px); overflow-y: auto; }
  dialog::backdrop {
    background: rgba(21,20,23,0.55);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
  dialog[open] {
    animation: modal-in 420ms cubic-bezier(0.16,1,0.3,1) both;
  }
  @keyframes modal-in {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    dialog[open] { animation: none; }
  }
</style>
