---
/**
 * Gründungsphase: ehrliche Einladung statt Rabatt-Banner.
 * Psychologie: «neu und innovativ — und Sie dürfen von Anfang an Teil davon sein.»
 * Steht bewusst nach der Founder-Sektion (dort wird die Jugend thematisiert).
 */
const vorteile = [
  { t: 'Sonderkonditionen zum Start', d: 'Die ersten Betriebe bauen ihr System zu Gründungskonditionen auf — das gibt es genau einmal.' },
  { t: 'Aufbau nach Mass', d: 'Noch kein Schema F: Ihre Struktur wird komplett auf Ihren Betrieb zugeschnitten — und prägt mit, wie das System weiterentwickelt wird.' },
  { t: 'Volle Aufmerksamkeit', d: 'Wenige Projekte, ein Name dran: Ihres bekommt nicht einen Bruchteil meiner Zeit, sondern den grössten Teil davon.' },
];
---

<section class="bg-white border-b border-stone/20 overflow-hidden" id="gruendung">
  <div class="max-w-[1240px] mx-auto px-6 md:px-10 py-20 md:py-24">
    <div class="gruendung-card relative rounded-2xl border border-bordeaux-700/25 bg-ivory overflow-hidden reveal">
      <div class="absolute inset-0 pointer-events-none"
           style="background: radial-gradient(90% 140% at 100% 0%, rgba(90,15,27,0.07), transparent 55%);"></div>

      <div class="relative grid lg:grid-cols-[1fr_0.9fr] gap-10 lg:gap-16 items-center px-7 md:px-12 py-12 md:py-14">

        <div>
          <span class="inline-flex items-center gap-2 text-[10.5px] tracking-[0.16em] uppercase font-semibold text-bordeaux-700 bg-bordeaux-50 border border-bordeaux-100 rounded-sm px-3 py-1.5 mb-6">
            <span class="gruendung-dot w-1.5 h-1.5 rounded-full bg-bordeaux-700"></span>
            Gründungsphase · begrenzt auf die ersten Betriebe
          </span>

          <h2 class="font-display font-medium text-ink m-0 mb-5"
              style="font-size: clamp(1.9rem, 3.2vw, 2.8rem); line-height: 1.08; letter-spacing: -0.03em;">
            Hier entsteht etwas Neues.<br />
            <em class="italic text-bordeaux-700" style="font-style:italic;">Und Sie können von Anfang an dabei sein.</em>
          </h2>

          <p class="text-[16px] leading-[1.75] text-slate m-0 mb-4 max-w-[56ch]">
            Pichler Advisory baut gerade mit den ersten Betrieben der Ostschweiz ein System auf,
            das es so für Handwerks-KMU noch nicht gibt: den ganzen Betrieb verbunden, vom ersten
            Anruf bis zur bezahlten Rechnung.
          </p>
          <p class="text-[16px] leading-[1.75] text-slate m-0 mb-8 max-w-[56ch]">
            Wer jetzt einsteigt, wird Teil dieses Aufbaus — zu Konditionen, die es später nicht
            mehr geben wird. Im Gegenzug werden Sie eine der Referenzen, auf denen alles Weitere
            aufbaut. Ehrlicher wird ein Angebot nicht.
          </p>

          <button data-open-contact class="btn-primary btn-lg">
            Einen der ersten Plätze anfragen
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </button>
        </div>

        <div class="flex flex-col gap-4 stagger">
          {vorteile.map((v, i) => (
            <div class="bg-white border border-stone/50 rounded-xl px-6 py-5 shadow-sm" style={`--i: ${i}`}>
              <p class="text-[14.5px] font-semibold text-ink m-0 mb-1.5">{v.t}</p>
              <p class="text-[13.5px] leading-[1.65] text-slate m-0">{v.d}</p>
            </div>
          ))}
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  .gruendung-dot {
    animation: gruendung-pulse 2.2s ease-in-out infinite;
  }
  @keyframes gruendung-pulse {
    0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(90,15,27,0.35); }
    50% { opacity: 0.7; box-shadow: 0 0 0 5px rgba(90,15,27,0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .gruendung-dot { animation: none; }
  }
</style>
