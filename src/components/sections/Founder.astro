---
/**
 * Gründer-Sektion: ersetzt DarkBand + AboutTeaser.
 * Ehrliche Positionierung — jung, digital aufgewachsen, direkte Umsetzung.
 */
const marker = [
  { f: '1', l: 'Ansprechperson — vom ersten Gespräch bis zum Betrieb' },
  { f: '100%', l: 'Umsetzung durch mich, keine Weitergabe' },
  { f: '24h', l: 'Antwort auf jede Anfrage, persönlich' },
];
---

<section class="relative bg-charcoal text-ivory overflow-hidden" id="ueber-mich">
  <div class="absolute inset-0 pointer-events-none"
       style="background: radial-gradient(70% 110% at 15% 0%, rgba(90,15,27,0.4), transparent 60%);"></div>

  <div class="relative max-w-[1240px] mx-auto px-6 md:px-10 py-20 md:py-[104px]">
    <div class="grid lg:grid-cols-[0.85fr_1.15fr] gap-12 lg:gap-20 items-center">

      <!-- Portrait (echtes Foto) -->
      <div class="reveal">
        <div class="rounded-xl overflow-hidden shadow-lg relative max-w-[420px] mx-auto lg:mx-0" style="aspect-ratio: 4/5;">
          <img
            src="/assets/maurus_portrait.jpg"
            alt="Maurus Pichler, Gründer von Pichler Advisory"
            width="1200" height="1600" loading="lazy"
            class="absolute inset-0 w-full h-full object-cover" style="object-position: 50% 20%;"
          />
          <div class="absolute bottom-0 left-0 right-0 p-5"
               style="background: linear-gradient(to top, rgba(21,20,23,0.85) 0%, transparent 100%);">
            <p class="text-[14px] font-semibold text-ivory m-0">Maurus Pichler</p>
            <p class="text-[12px] text-stone/80 m-0">Gründer, Pichler Advisory</p>
          </div>
        </div>
      </div>

      <!-- Story -->
      <div class="reveal" style="transition-delay: 100ms;">
        <span class="eyebrow eyebrow-light block mb-4">Wer dahinter steht</span>
        <h2 class="font-display font-medium text-ivory mt-4 mb-6"
            style="font-size: clamp(2rem, 3.4vw, 2.9rem); line-height: 1.08; letter-spacing: -0.03em;">
          Sie kennen Ihr Handwerk.<br />Ich kenne die Abläufe dahinter.
        </h2>

        <div class="flex flex-col gap-4 text-[16px] leading-[1.75] text-stone mb-8">
          <p class="m-0">
            Ich bin Maurus Pichler, Jahrgang 2006 — und ja, das steht hier bewusst. Ich bin mit den
            Werkzeugen aufgewachsen, die heute über Effizienz entscheiden. In meiner Ausbildung zum
            Entwickler digitales Business EFZ mache ich beruflich genau das, was Pichler Advisory
            anbietet: Prozesse analysieren, Engpässe finden, Abläufe automatisieren.
          </p>
          <p class="m-0">
            Was ich nicht mitbringe: zwanzig Jahre Beratungsfloskeln, ein Junior-Team und
            Konzeptpapiere für die Schublade. Was Sie bekommen: eine Person, die zuhört, versteht,
            selbst baut — und erreichbar bleibt, wenn etwas klemmt.
          </p>
          <p class="m-0">
            Ihr Fachwissen bleibt Ihres. Ich sorge dafür, dass drumherum nichts mehr verloren geht.
          </p>
        </div>

        <div class="grid sm:grid-cols-3 gap-6 border-t border-white/10 pt-8 stagger">
          {marker.map((m, i) => (
            <div style={`--i: ${i}`}>
              <span class="font-display text-[36px] font-medium leading-none text-ivory block mb-2">{m.f}</span>
              <span class="block w-7 h-px bg-bordeaux-300/70 mb-2.5"></span>
              <span class="text-[12.5px] leading-[1.5] text-stone/80">{m.l}</span>
            </div>
          ))}
        </div>

        <a href="/ueber-uns" class="btn-ghost px-0 mt-8 !text-ivory hover:!text-white">
          Mehr über mich
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>
