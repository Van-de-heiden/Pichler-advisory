---
/**
 * Vorgehen-Teaser: vier Phasen statt sechs — kompakt, mit klarem Ergebnis pro Phase.
 */
const phasen = [
  {
    num: '01',
    titel: 'Analysieren',
    desc: 'Ich schaue mir an, wie der Betrieb heute wirklich läuft: Anfragen, Offerten, Nachfassen, Büro. Vor Ort oder remote — ohne den Betrieb aufzuhalten.',
    ergebnis: 'Klartext-Bericht mit Schwachstellen',
  },
  {
    num: '02',
    titel: 'Priorisieren',
    desc: 'Nicht alles auf einmal. Wir bestimmen gemeinsam, was den grössten Effekt bei kleinstem Aufwand bringt — Quick Wins zuerst.',
    ergebnis: 'Massnahmenplan mit klarer Reihenfolge',
  },
  {
    num: '03',
    titel: 'Aufbauen',
    desc: 'Ich setze um: Abläufe verbinden, Automatisierungen bauen, Vorlagen erstellen, Team einführen. Schritt für Schritt, im laufenden Betrieb.',
    ergebnis: 'Funktionierende Struktur, dokumentiert',
  },
  {
    num: '04',
    titel: 'Betreiben & messen',
    desc: 'Nach vier Wochen schauen wir ehrlich hin: Was hat sich verändert — in Stunden, Reaktionszeit, Anfragen? Danach entscheiden Sie, ob ich weiter begleite.',
    ergebnis: 'Messbarer Vorher-nachher-Vergleich',
  },
];
---

<section class="bg-ivory border-y border-stone/20" id="vorgehen">
  <div class="max-w-[1240px] mx-auto px-6 md:px-10 py-20 md:py-24">
    <div class="grid lg:grid-cols-[0.8fr_1.2fr] gap-12 lg:gap-16 items-start">

      <!-- Left: heading -->
      <div class="reveal lg:sticky lg:top-28">
        <span class="eyebrow block mb-4">Vorgehen</span>
        <h2 class="font-display font-medium text-ink mt-4 mb-[18px]"
            style="font-size: clamp(2rem, 3.4vw, 3rem); line-height: 1.08; letter-spacing: -0.03em;">
          Erst verstehen.<br />
          <em class="italic text-bordeaux-700" style="font-style:italic;">Dann bauen.</em>
        </h2>
        <p class="text-[17px] leading-[1.7] text-slate mb-8">
          Vier Phasen, jede mit einem konkreten Ergebnis. Sie wissen zu jedem Zeitpunkt,
          was gerade passiert, was es kostet und was es bringt.
        </p>
        <a href="/vorgehen" class="btn-secondary">
          Vorgehen im Detail
        </a>
      </div>

      <!-- Right: phase list -->
      <div class="flex flex-col stagger">
        {phasen.map((p, i) => (
          <div class="border-t border-stone/40 py-7 grid sm:grid-cols-[56px_1fr] gap-4 items-start" style={`--i: ${i}`}>
            <span class="font-display text-[26px] font-medium text-bordeaux-300 leading-none mt-0.5">{p.num}</span>
            <div>
              <h3 class="text-[17px] font-semibold text-ink m-0 mb-2">{p.titel}</h3>
              <p class="text-[15px] leading-[1.65] text-slate m-0 mb-3">{p.desc}</p>
              <p class="text-[12.5px] tracking-[0.04em] text-bordeaux-700 font-medium m-0">
                → {p.ergebnis}
              </p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>
