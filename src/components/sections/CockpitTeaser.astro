---
/**
 * Beweis-Sektion: das Cockpit als codierte, ehrlich deklarierte Beispielansicht.
 * Kein Fake-Screenshot, kein KI-Bild — eine echte UI, gebaut mit denselben Mitteln
 * wie das spätere Kunden-Cockpit.
 */
const kpis = [
  { label: 'Umsatz diesen Monat', value: 'CHF 48’200', trend: '+12% zum Vormonat', up: true },
  { label: 'Offene Offerten', value: '7', trend: '2 zum Nachfassen fällig', up: false },
  { label: 'Neue Anfragen', value: '14', trend: 'Ø Antwortzeit: 3 Std.', up: true },
];
const auftraege = [
  { name: 'Umgebungsarbeiten Reihe EFH', status: 'In Arbeit', anteil: 68 },
  { name: 'Badumbau Wohnung Rüti', status: 'Offerte angenommen', anteil: 15 },
  { name: 'Unterhalt Siedlung Nord', status: 'Läuft monatlich', anteil: 100 },
];
---

<section class="bg-white" id="cockpit">
  <div class="max-w-[1240px] mx-auto px-6 md:px-10 py-20 md:py-24">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">

      <!-- Copy -->
      <div class="reveal">
        <span class="eyebrow block mb-4">Die Übersicht</span>
        <h2 class="font-display font-medium text-ink mt-4 mb-[18px]"
            style="font-size: clamp(2rem, 3.4vw, 3rem); line-height: 1.08; letter-spacing: -0.03em;">
          Sie spüren Ihren Betrieb.<br />
          <em class="italic text-bordeaux-700" style="font-style:italic;">Jetzt sehen Sie ihn auch.</em>
        </h2>
        <p class="text-[17px] md:text-[18px] leading-[1.7] text-slate mb-5">
          Zum Aufbau gehört ein einfaches Cockpit: Umsatz, offene Offerten, Anfragen und fällige
          Nachfassungen — auf einen Blick, auf dem Handy wie am Schreibtisch. Gespeist aus Ihren
          echten Zahlen, nicht aus einer weiteren Excel-Liste.
        </p>
        <p class="text-[15px] leading-[1.7] text-slate mb-8">
          Nebenan sehen Sie eine Beispielansicht — so ehrlich, wie wir auch zusammenarbeiten würden:
          Das ist kein Foto und kein Kunden-Screenshot, sondern eine gebaute Vorschau. Ihr Cockpit
          entsteht aus Ihrem Betrieb.
        </p>

        <button data-open-contact class="btn-primary">
          Betriebscheck anfragen
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </button>
      </div>

      <!-- Codiertes Cockpit -->
      <div class="reveal" style="transition-delay: 120ms;">
        <div class="rounded-xl overflow-hidden shadow-lg border border-white/10 bg-charcoal">
          <!-- Titelzeile -->
          <div class="flex items-center justify-between px-5 py-3.5 border-b border-white/10">
            <div class="flex items-center gap-2.5">
              <img src="/assets/shield.png" alt="" width="18" height="21" class="h-[18px] w-auto brightness-0 invert opacity-70" />
              <span class="text-[11.5px] font-medium tracking-[0.12em] uppercase text-stone/70">Betriebs-Cockpit</span>
            </div>
            <span class="text-[10px] tracking-[0.08em] uppercase text-stone/40 border border-white/15 rounded-sm px-2 py-1">Beispielansicht</span>
          </div>

          <!-- KPI-Zeile -->
          <div class="grid grid-cols-3 gap-px bg-white/5">
            {kpis.map((k) => (
              <div class="bg-graphite px-4 py-4">
                <p class="text-[10px] tracking-[0.08em] uppercase text-stone/50 m-0 mb-1.5 leading-snug">{k.label}</p>
                <p class="font-display text-[21px] md:text-[24px] font-medium text-ivory leading-none m-0 mb-1.5">{k.value}</p>
                <p class:list={['text-[10.5px] m-0 leading-snug', k.up ? 'text-positive' : 'text-bordeaux-300']}>{k.trend}</p>
              </div>
            ))}
          </div>

          <!-- Auftragsliste -->
          <div class="px-5 py-4">
            <p class="text-[10px] tracking-[0.1em] uppercase text-stone/40 m-0 mb-3">Laufende Aufträge</p>
            <ul class="m-0 p-0 list-none flex flex-col gap-3">
              {auftraege.map((a) => (
                <li>
                  <div class="flex items-center justify-between gap-3 mb-1.5">
                    <span class="text-[13px] text-ivory/90 truncate">{a.name}</span>
                    <span class="text-[11px] text-stone/60 whitespace-nowrap flex-shrink-0">{a.status}</span>
                  </div>
                  <div class="h-1 rounded-full bg-white/8 overflow-hidden" style="background: rgba(255,255,255,0.08);">
                    <div class="h-full rounded-full bg-bordeaux-300/80" style={`width: ${a.anteil}%`}></div>
                  </div>
                </li>
              ))}
            </ul>
          </div>

          <!-- Fusszeile -->
          <div class="flex items-center justify-between px-5 py-3 border-t border-white/10">
            <span class="text-[11px] text-stone/50">Nachfassen heute fällig</span>
            <span class="text-[13px] font-semibold text-ivory">2 Offerten</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
