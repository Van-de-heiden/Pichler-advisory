---
/**
 * Leistungen: drei Angebote, die aufeinander aufbauen — statt sechs generischer Kacheln.
 * Der Betriebscheck ist der bewusst niederschwellige Einstieg.
 */
const angebote = [
  {
    id: 'betriebscheck',
    nummer: '01',
    tag: 'Der Einstieg',
    titel: 'Digitaler Betriebscheck',
    lede: 'Wissen, wo es rausläuft.',
    text: 'Ich schaue mir an, wie Anfragen, Offerten, Nachfassen und Büroarbeit heute wirklich laufen — und wo Zeit und Aufträge verloren gehen. Sie erhalten Klartext: was liegt brach, was bringt am meisten, was zuerst.',
    punkte: ['Analyse der heutigen Abläufe und Werkzeuge', 'Konkrete Schwachstellen, in Franken und Stunden gedacht', 'Priorisierter Massnahmenplan mit Sofortmassnahmen'],
    rahmen: 'Fixer Rahmen, klarer Preis vorab',
    featured: true,
  },
  {
    id: 'betriebsstruktur',
    nummer: '02',
    tag: 'Das Kernprojekt',
    titel: 'Betriebsstruktur & Automatisierung',
    lede: 'Die Abläufe, die von allein laufen.',
    text: 'Ich baue die Struktur aus dem Betriebscheck: Anfragen werden automatisch erfasst, Offerten entstehen aus Vorlagen, Nachfassen ist terminiert, Bexio, Kalender und Website arbeiten zusammen. Auf Wunsch inklusive neuem Auftritt.',
    punkte: ['Anfrage- bis Rechnungsprozess sauber verbunden', 'Automatisierung mit Make, Bexio, CRM, Formularen', 'Dokumentiert und vom Team bedienbar'],
    rahmen: 'Projektbasis, nach Massnahmenplan',
    featured: false,
  },
  {
    id: 'laufender-betrieb',
    nummer: '03',
    tag: 'Die Begleitung',
    titel: 'Laufender Betrieb',
    lede: 'Damit es auch in sechs Monaten läuft.',
    text: 'Systeme brauchen Pflege: Ich überwache die Abläufe, passe an, wenn sich Ihr Betrieb verändert, werte die Zahlen aus und entwickle weiter. Sie haben eine Ansprechperson — keine Hotline.',
    punkte: ['Monatliche Auswertung und kurze Besprechung', 'Anpassungen und neue Automatisierungen inklusive Kontingent', 'Direkter Draht bei Problemen'],
    rahmen: 'Monatsmodell, jederzeit kündbar',
    featured: false,
  },
];
---

<section class="bg-white" id="leistungen">
  <div class="max-w-[1240px] mx-auto px-6 md:px-10 py-20 md:py-24">

    <div class="max-w-[680px] mb-14 reveal">
      <span class="eyebrow block mb-4">Leistungen</span>
      <h2 class="font-display font-medium text-ink mt-4 mb-5"
          style="font-size: clamp(2rem, 3.4vw, 3rem); line-height: 1.08; letter-spacing: -0.03em;">
        Drei Schritte.<br />
        <em class="italic text-bordeaux-700" style="font-style:italic;">Ein System.</em>
      </h2>
      <p class="text-[17px] md:text-[18px] leading-[1.75] text-slate m-0">
        Kein Bauchladen an Beratungsprodukten. Die drei Leistungen bauen aufeinander auf —
        und jede einzelne muss sich für Ihren Betrieb rechnen, sonst empfehle ich sie nicht.
      </p>
    </div>

    <div class="grid lg:grid-cols-3 gap-5 stagger">
      {angebote.map((a, i) => (
        <div id={a.id} class:list={['offer-card flex flex-col', { 'offer-featured': a.featured }]} style={`--i: ${i}`}>
          <div class="flex items-center justify-between mb-6">
            <span class="font-display text-[30px] font-medium leading-none"
                  class:list={a.featured ? 'text-bordeaux-300' : 'text-stone'}>{a.nummer}</span>
            <span class:list={[
              'text-[10.5px] tracking-[0.12em] uppercase font-semibold px-[11px] py-[5px] rounded-sm',
              a.featured ? 'bg-bordeaux-700 text-ivory' : 'bg-mist text-slate'
            ]}>{a.tag}</span>
          </div>

          <h3 class="font-display text-[25px] font-medium text-ink m-0 mb-1.5 leading-tight tracking-tight">{a.titel}</h3>
          <p class="text-[14px] font-semibold text-bordeaux-700 m-0 mb-4">{a.lede}</p>
          <p class="text-[14.5px] leading-[1.68] text-slate m-0 mb-6">{a.text}</p>

          <ul class="flex flex-col gap-2.5 m-0 mb-7 p-0 list-none">
            {a.punkte.map((p) => (
              <li class="flex items-start gap-2.5 text-[13.5px] leading-[1.55] text-slate">
                <span class="flex-shrink-0 w-[14px] h-[14px] mt-[3px] rounded-sm bg-bordeaux-50 text-bordeaux-700 flex items-center justify-center">
                  <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                </span>
                {p}
              </li>
            ))}
          </ul>

          <div class="mt-auto pt-5 border-t border-mist flex items-center justify-between gap-3">
            <span class="text-[12px] text-taupe leading-snug">{a.rahmen}</span>
            <a href={`/leistungen#${a.id}`} class="btn-ghost px-0 text-[13.5px] flex-shrink-0">
              Details
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .offer-card {
    background: white;
    border: 1px solid #E8E4DC;
    border-radius: 12px;
    padding: 30px;
    box-shadow: 0 1px 3px rgba(21,20,23,0.05);
    transition: transform 280ms cubic-bezier(0.2,0,0,1),
                box-shadow 280ms cubic-bezier(0.2,0,0,1),
                border-color 280ms cubic-bezier(0.2,0,0,1);
  }
  .offer-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(21,20,23,0.08);
    border-color: #D8D2C8;
  }
  .offer-featured {
    border-color: rgba(90,15,27,0.28);
    box-shadow: 0 6px 22px rgba(90,15,27,0.08);
  }
  .offer-featured:hover { border-color: rgba(90,15,27,0.45); }
</style>
